# ============================================================
# Lifeboat — env file for docker-compose.yaml
# Copy to .env, edit values, then `docker compose up -d`.
# Every variable is OPTIONAL except where marked REQUIRED.
# ============================================================

# ---------- Image / lifecycle ----------
# Pin to a specific Lifeboat version for reproducibility, e.g. "2.1.115".
# Use "latest" for the rolling tag (picks up the weekly rebuild).
LIFEBOAT_IMAGE_TAG=latest

# Container name shown in `docker ps`.
CONTAINER_NAME=lifeboat

# Restart policy for the main service. `always` = also restart on
# docker daemon restart. `unless-stopped` = don't restart after manual stop.
RESTART_POLICY=always

# ---------- Admin bootstrap (REQUIRED on first start) ----------
# Email shown in the audit log as the admin user.
LIFEBOAT_ADMIN_EMAIL=admin@iterate.ai

# Pick ONE of the two methods below — only set what you use.
#
# Method 1 (recommended): file on the host, bind-mounted into the
# container. Password never appears in `docker inspect` or /proc/<pid>/environ.
#     sudo mkdir -p /etc/lifeboat
#     sudo install -m 600 /dev/stdin /etc/lifeboat/admin-pass <<< 'YOUR-STRONG-PASSWORD'
# Then set ADMIN_PASS_FILE to that host path, and leave
# LIFEBOAT_ADMIN_PASSWORD blank.
ADMIN_PASS_FILE=/etc/lifeboat/admin-pass

# Method 2 (quick start, less secure): inline password in this file.
# Cleartext is visible to anyone with docker socket access via
# `docker inspect`. Leave ADMIN_PASS_FILE pointing at a non-existent
# path (e.g. /dev/null) if you use this.
LIFEBOAT_ADMIN_PASSWORD=

# ---------- Cluster (only if running multi-node) ----------
# HMAC secret shared by the control plane and every node agent. Same
# two-method pattern as the admin password.
#
# Method 1 (recommended):
#     sudo install -m 600 /dev/stdin /etc/lifeboat/cluster-secret <<< 'YOUR-SECRET'
CLUSTER_SECRET_FILE=/dev/null

# Method 2 (quick start, inline):
LIFEBOAT_CLUSTER_SECRET=
LIFEBOAT_AGENT_PORT=8002

# ---------- Ports + paths ----------
# Control plane (UI + REST API + inference proxy) port on the host.
LIFEBOAT_CONTROL_PORT=8001

# Host directory holding model files. Bind-mounted into the container at
# /models. Use an absolute path in production; the default is the `./models`
# subdir relative to docker-compose.yaml.
MODELS_DIR=/home/iterate-dev/models

# GPU selector. "all" passes every NVIDIA GPU on the host; "0" or "0,1" pins
# to specific GPU indices. Lifeboat's own UI handles per-server GPU
# selection on top of whatever the container sees.
GPU_DEVICE_SELECTOR=all

# ---------- AMD ROCm (only when running on AMD Instinct/Radeon) ----------
# Lifeboat ships TWO images. They are NOT interchangeable:
#
#   iterateai/lifeboat:latest       NVIDIA CUDA  (amd64 + arm64)
#   iterateai/lifeboat:latest-rocm  AMD ROCm     (amd64) - rolling AMD tag
#   iterateai/lifeboat:amd          AMD ROCm     (amd64) - same image, pinned name
#   iterateai/lifeboat:amd-mi300x   AMD ROCm     (amd64) - MI300X/MI325X (gfx942)
#
# `:latest` will NEVER include the AMD image. A container manifest list selects
# on os/architecture only — there is no GPU-vendor dimension — and both builds
# are linux/amd64, so one tag cannot hold both. Pulling `:latest` on an AMD box
# gets you a CUDA image that cannot run. Use latest-rocm / amd there.
#
# and TWO compose files, because GPU access works completely differently:
#
#   docker compose -f docker-compose.yaml      up -d   # NVIDIA (CDI devices)
#   docker compose -f docker-compose.rocm.yaml up -d   # AMD (/dev/kfd + /dev/dri)
#
# Everything below only applies to the ROCm file; the NVIDIA path ignores it.

# Which ROCm image tag to run. The AMD image is tagged separately on purpose —
# `latest` is the CUDA manifest list and will not run on an AMD GPU.
LIFEBOAT_ROCM_IMAGE_TAG=amd

# Pin the accelerator vendor instead of letting the control plane detect it.
# Detection keys on /dev/kfd (the ROCm compute node), so it is reliable when
# the devices are mapped — pinning exists so that a compose file with a
# BROKEN `devices:` block fails as "AMD expected, none visible" instead of
# quietly reporting a CPU-only host and refusing every launch for the wrong
# reason. Values: amd | nvidia | none. Leave blank for auto-detection.
LIFEBOAT_GPU_VENDOR=amd

# Force a gfx target when ROCm misidentifies the silicon (e.g. an unsupported
# consumer part masquerading as a supported one). LEAVE BLANK unless AMD
# support tells you otherwise: an override that does not match the hardware
# produces wrong kernels and garbage output, not a clean error.
#HSA_OVERRIDE_GFX_VERSION=

# ---------- Why the ROCm compose file uses `ipc: host` --------------------
# It is required, not a convenience, and there is no shm_size to go with it.
# Measured on an MI210: with a private/shareable IPC namespace the engine dies
# at its first GPU allocation with an HSA-level
#   "Memory critical error by agent node-0 ... Reason: Memory in use."
# which names neither IPC nor shared memory and reads like a driver fault. Host
# IPC is the whole fix. With it the container uses the HOST's /dev/shm, so
# LIFEBOAT_SHM_SIZE does not apply on ROCm — size the host's /dev/shm instead
# if a tp>1 launch reports insufficient_shared_memory.

# ---------- What is NOT available on AMD (so you do not go looking) --------
# These are hardware/ecosystem facts, not missing features:
#
#   FP8 KV cache          needs CDNA3 (gfx942 / MI300X) or newer. On CDNA2
#                         (gfx90a / MI210, MI250) there is no FP8 tensor
#                         path at all, so the launch profile strips the flag
#                         and logs that it did.
#   FP4 (NVFP4/MXFP4)     NVFP4 checkpoints are read by NVIDIA cutlass
#                         kernels with no ROCm build; AMD FP4 starts at CDNA4
#                         (gfx950 / MI350). An FP4 checkpoint is refused with
#                         an actionable message.
#   flashinfer            CUDA-only by construction (it emits PTX/cubin).
#                         The attention backend defaults to triton, which
#                         JIT-compiles for whatever gfx the device reports.
#   SM partitioning       built on CUDA MPS, which ROCm has no equivalent of.
#                         The fair scheduler still applies.
#   Confidential computing AUTO-DISABLED on AMD. GPU CC needs an NVIDIA
#                         CC-mode GPU inside a CVM; an AMD EPYC SEV-SNP host
#                         satisfies only the CPU half. You no longer need to
#                         avoid `require` — Lifeboat downgrades it to `off` on
#                         an AMD GPU and logs why, instead of refusing every
#                         server start forever. Status reports
#                         `unsupported_accelerator`. Note that sealed
#                         (cc_encrypted) model weights are still REFUSED here
#                         rather than silently unwrapped, since their key can
#                         only be released inside an attested TEE.
#   Multi-node agents     the node agent is not yet validated on ROCm; run
#                         AMD nodes single-node for now.

# ---------- Watchdog / supervisor (advanced) ----------
# Max consecutive auto-restart attempts before the watchdog gives up
# and surfaces a hard failure.
LIFEBOAT_MAX_AUTO_RESTARTS=5

# Seconds the watchdog waits between restart attempts after a failure.
LIFEBOAT_RESTART_COOLDOWN=60

# How long a server can sit in STARTING before it's considered hung.
LIFEBOAT_STARTING_TIMEOUT_SEC=900

# A server is only declared stuck once it has ALSO stopped writing to its log
# for this many seconds. Weight loading and CUDA-graph capture emit a progress
# line per step, so silence — not elapsed time — is what separates a hung
# start from a merely slow one. A large MoE on a modest box can legitimately
# spend 15+ minutes capturing CUDA graphs.
LIFEBOAT_STARTING_STALL_SEC=300

# Hard ceiling that a still-writing log CANNOT extend. "Still logging" is only
# a proxy for "still working": a server wedged in a retry loop keeps writing
# forever and would never be declared stuck. Nothing legitimate takes an hour.
LIFEBOAT_STARTING_HARD_TIMEOUT_SEC=3600

# SIGTERM → SIGKILL grace period on server stop.
LIFEBOAT_STOP_GRACE_SEC=30

# Allow a server to stay UNHEALTHY this long before the watchdog acts.
LIFEBOAT_UNHEALTHY_GRACE_SEC=120

# How often to scan for zombie inference worker processes.
LIFEBOAT_ZOMBIE_REAP_INTERVAL=30

# ---------- Inference proxy / load balancer (advanced) ----------
# Routing mode lives in the SQLite config table, not here — set it from
# the Configuration page in the UI. The variables below tune the behavior
# of each mode and only need overriding for non-standard workloads.
#
# The per-cluster LB algorithm (weighted_round_robin / least_connections /
# sticky_session) is also NOT an env var — it's stored on the clusters
# row and picked in the Edit Cluster modal. Sticky-session uses the
# X-Lifeboat-Session-Id header (else a blake2b digest of the bearer key)
# to keep a client on the same backend for prefix-cache reuse.

# SuperFast (and Hybrid-cold) per-server in-flight cap. Lower = lower TTFT
# per request, fewer concurrent decodes; higher = more throughput, slower
# TTFT. Effective cap is min(per-server max_concurrency, this).
LIFEBOAT_LB_SUPERFAST_CAP=4

# Hybrid switches to the configured per-server cap once EITHER signal
# crosses its threshold (in-flight count or req/s averaged over WINDOW_SEC).
LIFEBOAT_LB_HYBRID_INFLIGHT=10
LIFEBOAT_LB_HYBRID_RATE=10.0
LIFEBOAT_LB_HYBRID_WINDOW_SEC=5.0

# Hysteresis deadband — once a pool flips hot, both signals must drop
# below threshold * this ratio before it cools. Prevents flutter at the
# threshold. Set to 1.0 to disable.
LIFEBOAT_LB_HYBRID_HOT_EXIT_RATIO=0.8

# Queue-All mode forces the queue on regardless of LIFEBOAT_LB_QUEUE_ENABLED
# and uses these expanded knobs. Designed to never reject under normal
# operation; clients still time out themselves.
LIFEBOAT_LB_QUEUE_ALL_DEPTH_MULTIPLIER=1000
LIFEBOAT_LB_QUEUE_ALL_TTL_SEC=600

# Set to "true" to queue requests when every backend is at capacity instead
# of immediately 503'ing. Pairs with a sensible per-server max_concurrency.
# Queue-All mode ignores this and forces the queue on.
LIFEBOAT_LB_QUEUE_ENABLED=false

# Max time (seconds) a waiter stays queued before getting 504.
LIFEBOAT_LB_QUEUE_TTL_SEC=30

# Queue depth ceiling = this × Σ(max_concurrency over the pool).
LIFEBOAT_LB_QUEUE_MAX_DEPTH_MULTIPLIER=4

# Waiters parked this long get priority over fresh ones (anti-starvation).
LIFEBOAT_LB_QUEUE_DEADLINE_BOOST_SEC=10

# Garbage-collect pool routing state idle longer than this many seconds.
LIFEBOAT_LB_POOL_LRU_TTL_SEC=300

# Per-image token padding when estimating request input length for fit checks.
LIFEBOAT_LB_IMAGE_TOKENS=2048

# ---------- Automatic VRAM sizing ----------
# When a server's mem_fraction_static is left on Auto, Lifeboat sizes it from
# live GPU usage at every start. GB to hold back for each server that shares
# the same GPU but has not started yet and has no measured footprint on record.
# Stops the first server on a shared GPU from claiming the whole card; ignored
# once a co-resident server has run once and its real footprint is known.
LIFEBOAT_AUTO_MEM_PEER_GB=8

# Ceiling on the TOTAL held back for co-resident servers, as a fraction of the
# GPU. The reserve above scales with the number of server ROWS, not with what
# will actually run, so a box carrying several stopped rows could otherwise
# starve the one server serving traffic.
LIFEBOAT_AUTO_MEM_PEER_MAX_FRACTION=0.4

# Seconds the watchdog lets a freshly-spawned control plane stay unreachable
# before treating it as failed. Must exceed cold-start time (DB migrations +
# GPU probe + boot auto-start); restarting inside that window spawns a second
# control plane that fights the first for port 8001.
LIFEBOAT_WATCHDOG_STARTUP_GRACE=180

# Bytes of uploaded audio counted as one input token when sizing a
# /v1/audio/transcriptions request. 16 kHz 16-bit mono PCM at ~50 ASR
# frames/sec is ~640 bytes/frame. Compressed audio (mp3/opus) is denser
# per byte, so the default UNDER-estimates it; lower this if you route
# large compressed uploads through backends with a max_input_tokens cap.
LIFEBOAT_LB_AUDIO_BYTES_PER_TOKEN=640

# How often to cross-check inflight counters against the running-server set.
LIFEBOAT_LB_REAPER_INTERVAL_SEC=60

# Cache TTL for the /v1/models response in the proxy.
LIFEBOAT_PROXY_CACHE_TTL=30

# Max in-flight upstream connections from proxy to any one backend.
LIFEBOAT_PROXY_MAX_CONNECTIONS=200

# Per-backend keepalive cap.
LIFEBOAT_PROXY_MAX_KEEPALIVE=50

# ---------- Server warmup ----------
# After a server reaches healthy/running, the control plane sends one tiny
# request to it so the FIRST real request isn't cold (CUDA-graph capture,
# kernel JIT and the KV pool are all touched). On by default; set to 0/false
# to disable. Local servers only.
LIFEBOAT_WARMUP_ON_START=true
# How long to wait for a server to become healthy before warming it (sec).
LIFEBOAT_WARMUP_TIMEOUT_SEC=300
# Timeout for the warmup request itself (sec) — a cold 27B can be slow.
LIFEBOAT_WARMUP_REQUEST_TIMEOUT_SEC=120
# Timeout for the inference-diagnostics endpoint's probes (sec).
LIFEBOAT_DIAGNOSTICS_TIMEOUT_SEC=120
# On control-plane/VM start, servers that were running are auto-relaunched.
# With this on (default), they start ONE AT A TIME — each must finish loading
# and warming up before the next starts — so two models never initialize CUDA
# on the same GPU at once. Set false for the old parallel (1s-staggered) boot.
LIFEBOAT_AUTOSTART_SEQUENTIAL=true
# Max time (sec) to wait for one server to become healthy before starting the
# next during sequential auto-start (bounds total boot time if one wedges).
LIFEBOAT_AUTOSTART_READY_TIMEOUT_SEC=600

# ---------- Secondary GGUF engine ----------
# The tensor engine loads GGUF via transformers' GGUF table, so GGUFs whose arch it can't
# map (e.g. Qwen3.5 'qwen35'), GGUF vision (mmproj) and GGUF embeddings run on
# the bundled GGUF engine instead. Pick the engine per
# server in the UI (Auto / tensor engine / GGUF engine); Auto routes such GGUFs here.
# Path to the GGUF engine binary. Bundled in the image; set only on dev boxes.
LIFEBOAT_LLAMACPP_BIN=/opt/llama.cpp/bin/llama-server
# GPU layers to offload (99 = all on GPU; lower to spill to CPU on tight VRAM).
# Leave EMPTY to derive it: 99 when an accelerator is visible, 0 on a CPU-only
# host. Setting 99 explicitly on a CPU-only box is harmless but puts GPU
# language in the log of a server that is running on the CPU.
LIFEBOAT_LLAMACPP_NGL=99
# CPU threads for the GGUF engine. Empty (default) = derived from PHYSICAL
# cores, honouring the container's cgroup CPU quota. That derivation matters:
# the engine's own default comes from the cores it can SEE, which inside a
# `--cpus 2` container is the host's count -- so it would spawn one GEMM thread
# per host core against two cores' worth of quota. Physical rather than logical
# because SMT siblings share the vector units the GEMM already saturates, so
# oversubscribing costs throughput instead of adding it. Sets both --threads
# (decode) and --threads-batch (prefill).
LIFEBOAT_LLAMACPP_THREADS=
# Quantized KV cache for the GGUF engine -- its own KV compression, and the
# closest analogue to TurboQuant on that engine (the lifeboat_* suite is a
# tensor-engine feature). Empty = auto: q8_0 for K on memory-constrained hosts
# (integrated GPU, small discrete card, CPU-only), the engine's default
# otherwise. q8_0 is near-lossless and halves the cache it applies to.
#
# Only K is set automatically, deliberately: a quantized V cache requires
# flash-attention to be active in the build, and if it is off the launch FAILS
# rather than degrades. Set V explicitly only if you know FA is on.
LIFEBOAT_LLAMACPP_CACHE_TYPE_K=
LIFEBOAT_LLAMACPP_CACHE_TYPE_V=
# Concurrent request slots. Empty (default) = derived from the server's LB
# max_concurrency (clamped to <=16) so the engine has as many slots as the LB
# dispatches. Set a number to override. KV cache splits across slots, so a high
# value reduces per-slot context.
LIFEBOAT_LLAMACPP_PARALLEL=
# Extra raw GGUF-engine args (shell-meta chars rejected), e.g. "--no-mmap".
LIFEBOAT_LLAMACPP_EXTRA_ARGS=
# Embedding pooling override. Empty (default) = use the GGUF's own pooling
# metadata (correct for most embedders). Set only to force one of:
# none|mean|cls|last|rank — wrong value corrupts embeddings.
LIFEBOAT_LLAMACPP_POOLING=

# ---------- Memory budget (hardware profile) ----------
# Held back from the model-size budget that GET /api/hardware/profile reports.
# These do NOT cap anything at runtime -- they shape the RECOMMENDATION, so a
# host is not advised to load a model that will not leave room for the OS.
#
# Both apply on a host whose accelerator memory is SHARED with the system
# (integrated GPU, unified memory, CPU-only); a discrete card with its own VRAM
# pays only the second, because the OS does not live in VRAM.
#
# Lower the host reserve on a dedicated appliance with no desktop; raise it on
# a general-purpose box that also runs other services.
LIFEBOAT_HOST_RESERVE_GB=1.6
LIFEBOAT_CP_RESERVE_GB=0.35

# ---------- Lifeboat Lite (docker-compose.cpu.yaml only) ----------
# The universal-hardware image: control plane + GGUF engine, ~250 MB, no torch
# and no vendor runtime. For CPU-only hosts, integrated GPUs and 8 GB boxes.
# NOTE it contains no tensor engine, so none of the lifeboat_* optimizations
# apply -- GET /api/hardware/profile says so explicitly.
LIFEBOAT_LITE_IMAGE_TAG=lite
# Optional GPU passthrough for the Lite image, via Vulkan (covers Intel iGPUs,
# AMD, and older NVIDIA cards). Set to /dev/dri:/dev/dri to enable.
#
# The default is a /dev/null self-mapping and that is load-bearing, not a
# placeholder: Docker REFUSES to start a container whose devices: entry does
# not exist on the host, so naming /dev/dri unconditionally would break every
# genuinely CPU-only deployment.
LIFEBOAT_GPU_DEVICE=/dev/null:/dev/null

# ---------- Model downloads ----------
# Cap on individual model download time (seconds).
LIFEBOAT_MODEL_DOWNLOAD_TIMEOUT_SECONDS=3600

# Keep finished download progress entries this long (seconds, for the UI).
LIFEBOAT_DOWNLOAD_PROGRESS_RETENTION=86400

# HuggingFace personal access token for gated model downloads.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Where HF caches downloaded model weights inside the container. Default
# puts it in the persistent volume so weights survive container recreate.
HF_HOME=/opt/lifeboat/.lifeboat/hf_cache

# Use the high-speed hf_transfer protocol (recommended).
HF_HUB_ENABLE_HF_TRANSFER=1

# ---------- TLS (optional) ----------
# Set TLS_CERT_DIR to a host directory containing cert.pem + key.pem to
# serve the control plane over HTTPS. The dir is mounted read-only at
# /certs in the container.
TLS_CERT_DIR=/dev/null
LIFEBOAT_TLS_CERT=
LIFEBOAT_TLS_KEY=

# ---------- CUDA / PyTorch ----------
# PyTorch memory allocator config. expandable_segments=True helps avoid
# fragmentation on long-running inference workloads.
PYTORCH_ALLOC_CONF=expandable_segments:True

# Which GPUs are visible to the container. Usually leave as "all".
NVIDIA_VISIBLE_DEVICES=all

# Driver capabilities exposed. "compute,utility" is enough for inference;
# add "graphics" if you do anything GPU-rendered.
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Container shared-memory (/dev/shm) size. NCCL uses /dev/shm for
# intra-node transport between tensor-parallel ranks, so multi-GPU
# servers (tp_size >= 2) FAIL to start on Docker's 64MB default with
# "NCCL error: unhandled system error". 8gb is plenty for typical TP;
# raise it for very large models or high tp_size. Single-GPU is unaffected.
LIFEBOAT_SHM_SIZE=8gb

# Size of the RAM-backed tmpfs at /tmp. This is nvcc's scratch during CUDA JIT,
# and 512M is NOT enough to expand CUTLASS templates — the build dies with a
# misleading compiler error ("error while writing generated C file: No space
# left on device"). It only bites on arch/platform combos with no prebuilt
# kernels, where every kernel JITs on the first server start. Raise to 2G if you
# see that error. tmpfs is RAM, so on a unified-memory host (GB10) it competes
# with the model — LIFEBOAT_JIT_TMPDIR already points the bulk of the scratch at
# the persistent data volume instead.
LIFEBOAT_TMP_SIZE=512M

# Before launching a multi-GPU (tp_size >= 2) server the control plane
# preflights /dev/shm and refuses with a clear, actionable message when it's
# too small — instead of letting NCCL crash cryptically. These tune that
# check (defaults work in production):
#   LIFEBOAT_SHM_PREFLIGHT       1 = on (default); 0/false = skip the check.
#   LIFEBOAT_SHM_MIN_MB_PER_RANK MB of /dev/shm required per TP rank
#                                (default 256, with a 512 MB floor).
#LIFEBOAT_SHM_PREFLIGHT=1
#LIFEBOAT_SHM_MIN_MB_PER_RANK=256

# ---------- JIT / cache locations ----------
# All caches must live on a writable mount because root_fs is read-only.
# Defaults below land everything inside the persistent lifeboat-data
# volume (/opt/lifeboat/.lifeboat). Override only if you have a reason
# (e.g. pointing at a separate fast NVMe volume).
FLASHINFER_WORKSPACE_DIR=/opt/lifeboat/.lifeboat/.cache/flashinfer
FLASHINFER_JIT_CACHE_DIR=/opt/lifeboat/.lifeboat/.cache/flashinfer
TRITON_CACHE_DIR=/opt/lifeboat/.lifeboat/.cache/triton
XDG_CACHE_HOME=/opt/lifeboat/.lifeboat/.cache

# The image's venv directory is named after its Python minor version, and
# compose bind-mounts a writable overlay onto
#   /opt/lifeboat/venv/lib/${LIFEBOAT_PYTHON}/site-packages/flashinfer_cubin/cubins
# so flashinfer can fetch cubins at runtime on a read-only rootfs. This MUST
# match the image you run: Ubuntu 24.04 images are python3.12, Ubuntu 22.04
# images are python3.10. A wrong value does NOT error — it silently creates a
# bind mount at a path that does not exist, and flashinfer is back to failing
# on the read-only rootfs.
#
# Published images are python3.12 on both architectures from 2.2.23 onward,
# which is also the compose default, so leave this commented out unless you
# build your own image on a 22.04 base.
#LIFEBOAT_PYTHON=python3.12

# Where that writable overlay lives. The default is a NAMED VOLUME
# (lifeboat-flashinfer-cubins), which Docker seeds from the image's own 1.9 GB
# of prebuilt cubins and creates writable by the container user. Setting this to
# a HOST PATH turns it into a bind mount, which starts EMPTY — hiding every
# shipped cubin so each kernel is re-fetched or JIT'd — and, if root created the
# directory, is unwritable by uid 999 so flashinfer fails exactly as it would on
# the read-only rootfs. Only set this if you pre-seed the directory from the
# image and `chown 999:999` it.
#FLASHINFER_CUBIN_HOST_DIR=lifeboat-flashinfer-cubins

# Use the new high-speed HF transfer (Xet) protocol. Replaces the
# deprecated HF_HUB_ENABLE_HF_TRANSFER above (both can coexist for now).
HF_XET_HIGH_PERFORMANCE=1

# ---------- Logging ----------
# Max log file size before rotation.
LOG_MAX_SIZE=50m

# How many rotated log files to keep.
LOG_MAX_FILES=3

# ---------- Licensing ----------
# All optional — defaults work for the iterate.ai production license
# server. See the "Licensing & Activation" section in the top-level
# README.md for the full flow (24h trial, online vs offline vs AMI).

# Activation server base URL. Override for staging or an on-prem mirror.
# LIFEBOAT_LICENSE_SERVER_URL=https://license.interplay.iterate.ai

# AWS Marketplace product code. Set this in your AMI build so first
# boot self-issues a license bound to the EC2 instance-id (no
# customer activation step needed). Leave at the placeholder for
# non-AMI installs — IMDSv2 probing fails silently on non-AWS hosts.
# LIFEBOAT_AMI_PRODUCT_CODE=PLACEHOLDER_MARKETPLACE_SKU

# Length of the trial window. 24h is the standard; raise only for
# extended-eval contracts. The clock is cluster-wide, anchored on
# first_boot_at, and survives docker restart when a volume is mounted.
# LIFEBOAT_GRACE_HOURS=24

# How often the control plane phones home with pod_count + version.
# 6h is a good balance; the heartbeat is best-effort (failure does
# NOT change state, so a network blip can't lock customers out).
# LIFEBOAT_HEARTBEAT_INTERVAL_HOURS=6

# Install telemetry. ON by default. Covers a HARDWARE description (CPU, GPU,
# memory, accelerator vendor) and a lifecycle state word -- never a model
# name, a prompt, or a token count. The full description is sent ONCE and is
# thereafter represented by a 16-character fingerprint, so a steady-state
# heartbeat is ~160 bytes. See docs/telemetry.md for the exact payload.
#
# Setting this off stops the hardware block and the census beat below. It does
# NOT stop the licence heartbeat: proving a licence is bound to one cluster is
# a contractual obligation, not telemetry. An OFFLINE licence sends nothing at
# all, in any configuration.
# LIFEBOAT_TELEMETRY=on

# How often an install with NO licence key reports that it exists, so an
# evaluation in the trial window is visible to support. Carries no licence key
# and nothing about workload. Floor is 1 hour.
# LIFEBOAT_CENSUS_INTERVAL_HOURS=24

# Where a 402 (or an edition-cap 402 on the free tier) points the operator to
# upgrade. Override only for a staging portal.
# LIFEBOAT_PORTAL_URL=https://license.interplay.iterate.ai/lifeboat/portal

# ---------- In-app billing portal (self-serve upgrade) ----------
# The "CC — Upgrade" button on the License page opens the customer's Stripe
# Billing Portal. The control plane holds NO Stripe secret — it calls the
# dedicated billing-portal flow on the license server
# (LIFEBOAT_LICENSE_SERVER_URL + /lifeboat/billing-portal, from
# scripts/lifeboat_billing_portal_flow.json), which owns the Stripe key and
# authenticates the customer from the license_key. So there is no env var to
# set on the control plane for this — configure the Stripe key on that flow
# instead. (The endpoint reuses LIFEBOAT_LICENSE_SERVER_URL, above.)

# ---------- Confidential computing (TEE) ----------
# Protects model weights + prompts in-use when the HOST is a confidential
# VM (AMD SEV-SNP / Intel TDX) with the NVIDIA GPU in CC mode (Hopper
# H100/H200 or Blackwell). Lifeboat only DETECTS + ATTESTS + gates here;
# the TEE itself is provided by the host/VM, not by this container.
#
# LICENSED CAPABILITY: confidential computing only engages when your
# active license entitles it. The setting below is a REQUEST — without a
# CC entitlement it stays dormant (the License page shows "Not licensed").
# Contact iterate.ai to add confidential computing to your license.
#
# Mode:
#   auto    (default) detect the host; if it's a CC-capable TEE, attest
#           and report it. NEVER blocks server start — a non-CC host is
#           unaffected, so this is safe to leave on everywhere.
#   off     disable the feature entirely.
#   require HARD GATE: inference-server start is blocked (HTTP 403) unless
#           the host is an attested TEE. Use for regulated workloads.
# LIFEBOAT_CONFIDENTIAL_COMPUTING=auto

# How GPU attestation is verified:
#   local   (default) use the on-box NVIDIA attestation SDK if present,
#           else fall back to the device's self-reported CC state.
#   remote  verify evidence against NVIDIA's Remote Attestation Service.
#   disabled  skip cryptographic attestation (detection only).
# LIFEBOAT_CC_ATTESTATION_MODE=local

# NVIDIA Remote Attestation Service URL (only used when mode=remote).
# LIFEBOAT_CC_NRAS_URL=https://nras.attestation.nvidia.com

# How often (hours) to re-attest. Attestation can lapse on GPU reset or
# CVM live-migration; the re-check keeps the `require` gate honest.
# Clamped to [5 minutes, 24 hours]; an unparseable value falls back to 6.
# LIFEBOAT_CC_VERIFY_INTERVAL_HOURS=6

# Confidential-VM guest device to pass into the container. REQUIRED for
# CC detection under Docker: the control plane looks for /dev/sev-guest
# (AMD SEV-SNP) or /dev/tdx_guest (Intel TDX) to confirm it's running in
# a confidential VM, but Docker's minimal /dev exposes neither — so a
# genuine CVM is reported as "not a confidential VM" until you set this.
# Format is host-path:container-path. Leave unset (default is a harmless
# /dev/null self-mapping) on non-CC hosts: Docker REFUSES to start a
# container whose devices: entry doesn't exist on the host.
#   LIFEBOAT_CC_GUEST_DEVICE=/dev/sev-guest:/dev/sev-guest    # AMD SEV-SNP
#   LIFEBOAT_CC_GUEST_DEVICE=/dev/tdx_guest:/dev/tdx_guest    # Intel TDX
# LIFEBOAT_CC_GUEST_DEVICE=

# Interpreter that owns the NVIDIA attestation SDK. The SDK pins
# cryptography==43.0.1 — below the CVE-2024-12797 floor the control plane
# needs — so the image keeps it in its own venv and drives it over a
# subprocess boundary instead of importing it. The default is that venv;
# override only on a dev box where you pip-installed the SDK elsewhere. If
# the path isn't executable, Lifeboat tries an in-process import and then
# degrades to the device self-report (attestation reads verified=false).
# LIFEBOAT_CC_ATTEST_PYTHON=/opt/nv-attest/bin/python

# Optional NVIDIA appraisal-policy file (JSON, with an "authorization-rules"
# object), as a path INSIDE the container — mount it in yourself. Without
# one, an attestation verifies that the GPU's signed report is authentic.
# With one, the report's claims must also match your required values (CC
# mode, driver/VBIOS versions, ...) or the host reads as un-attested. Fails
# closed: an unreadable policy file makes attestation report an error.
# LIFEBOAT_CC_POLICY_FILE=

# Encrypted-weight decryption target (debug knob; leave unset).
# An encrypted checkpoint is decrypted shard-by-shard into an anonymous
# in-RAM memfd, which safetensors mmaps — plaintext weights never touch a
# disk. Set this to 1 to force the portable in-memory fallback instead
# (also RAM-only, but it holds roughly one extra shard's worth of plaintext
# while loading). Lifeboat already falls back on its own if the memfd path
# isn't usable, so this is only for reproducing that path deliberately.
# LIFEBOAT_CC_WEIGHTS_INMEM=

# ---------- Audit log ----------
# Throttle window (seconds) for repeated /v1/* API-key rejections in the
# audit log. The first hit per (reason, key-prefix, source-IP, path) is
# logged, then repeats are suppressed for this long — so a misconfigured
# client polling with a bad key can't bury operator actions (server
# delete/stop, config/cluster changes). 0 disables throttling.
# LIFEBOAT_AUDIT_REJECT_THROTTLE_SEC=600

# ---------- Logging ----------
# Level for the control plane's OWN logger. This is SEPARATE from uvicorn's
# HTTP access log, which is always on. INFO (the default) is where the
# operational decisions get reported and is what you want during an incident:
# the derived auto mem-fraction and peer reserve, measured footprints, warmup
# results, error->running reconciliation, spec-decode auto-resolution,
# GGUF engine auto-routing and the embedding auto-detect. Set WARNING for a
# quieter log, DEBUG when diagnosing.
# LIFEBOAT_LOG_LEVEL=INFO

# Max concurrent text-to-speech subprocesses behind POST /v1/audio/speech.
# TTS does NOT go through the load balancer (there is no backend server to
# balance across), so this is its capacity gate. Each invocation reloads the
# whole model, so high values multiply memory without improving throughput —
# 5 concurrent requests were measured holding 4.2 GB of RSS plus GPU memory.
# Requests above the cap queue rather than being rejected.
LIFEBOAT_TTS_MAX_CONCURRENCY=2
